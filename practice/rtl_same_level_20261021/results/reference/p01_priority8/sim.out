:vpi_module "D:\fgpa\readable-rtl-agent\.tools\iverilog\lib\ivl\va_math.vpi";
:vpi_module "D:\fgpa\readable-rtl-agent\.tools\iverilog\lib\ivl\v2009.vpi";
S_000001f78eb3a0a0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_000001f78eb39ac0 .scope module, "tb" "tb" 3 2;
 .timescale -9 -12;
v000001f78eb4f8c0_0 .var/i "checks", 31 0;
v000001f78eb47670_0 .var/i "expected_index", 31 0;
v000001f78eb477b0_0 .var "expected_valid", 0 0;
v000001f78eb47b70_0 .var "in", 7 0;
v000001f78eb46d10_0 .net "index", 2 0, v000001f78eb505a0_0;  1 drivers
v000001f78eb46e50_0 .var/i "remaining_value", 31 0;
v000001f78eb46f90_0 .net "valid", 0 0, v000001f78eb4f820_0;  1 drivers
v000001f78eb46db0_0 .var/i "value", 31 0;
S_000001f78eb4a900 .scope module, "dut" "TopModule" 3 8, 4 2 0, S_000001f78eb39ac0;
 .timescale 0 0;
    .port_info 0 /INPUT 8 "in";
    .port_info 1 /OUTPUT 3 "index";
    .port_info 2 /OUTPUT 1 "valid";
v000001f78eb39c50_0 .var/i "bit_no", 31 0;
v000001f78eb39cf0_0 .net "in", 7 0, v000001f78eb47b70_0;  1 drivers
v000001f78eb505a0_0 .var "index", 2 0;
v000001f78eb4f820_0 .var "valid", 0 0;
E_000001f78e6eba00 .event anyedge, v000001f78eb39cf0_0;
S_000001f78eb4a5e0 .scope module, "__rtl_agent_watchdog" "__rtl_agent_watchdog" 5 2;
 .timescale -9 -12;
S_000001f78eb4a770 .scope module, "__rtl_agent_waveform" "__rtl_agent_waveform" 6 1;
 .timescale -9 -12;
    .scope S_000001f78eb4a900;
T_0 ;
    %wait E_000001f78e6eba00;
    %pushi/vec4 0, 0, 3;
    %store/vec4 v000001f78eb505a0_0, 0, 3;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v000001f78eb4f820_0, 0, 1;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v000001f78eb39c50_0, 0, 32;
T_0.0 ; Top of for-loop
    %load/vec4 v000001f78eb39c50_0;
    %cmpi/s 8, 0, 32;
	  %jmp/0xz T_0.1, 5;
    %load/vec4 v000001f78eb39cf0_0;
    %load/vec4 v000001f78eb39c50_0;
    %part/s 1;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.3, 8;
    %load/vec4 v000001f78eb39c50_0;
    %parti/s 3, 0, 2;
    %store/vec4 v000001f78eb505a0_0, 0, 3;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v000001f78eb4f820_0, 0, 1;
T_0.3 ;
T_0.2 ; for-loop step statement
    %load/vec4 v000001f78eb39c50_0;
    %addi 1, 0, 32;
    %store/vec4 v000001f78eb39c50_0, 0, 32;
    %jmp T_0.0;
T_0.1 ; for-loop exit label
    %jmp T_0;
    .thread T_0, $push;
    .scope S_000001f78eb39ac0;
T_1 ;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v000001f78eb4f8c0_0, 0, 32;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v000001f78eb46db0_0, 0, 32;
T_1.0 ; Top of for-loop
    %load/vec4 v000001f78eb46db0_0;
    %cmpi/s 256, 0, 32;
	  %jmp/0xz T_1.1, 5;
    %load/vec4 v000001f78eb46db0_0;
    %pad/s 8;
    %store/vec4 v000001f78eb47b70_0, 0, 8;
    %load/vec4 v000001f78eb46db0_0;
    %store/vec4 v000001f78eb46e50_0, 0, 32;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v000001f78eb47670_0, 0, 32;
T_1.3 ;
    %load/vec4 v000001f78eb46e50_0;
    %cmpi/s 1, 0, 32;
    %flag_or 5, 4; GT is !LE
    %flag_inv 5;
    %jmp/0xz T_1.4, 5;
    %load/vec4 v000001f78eb46e50_0;
    %pushi/vec4 2, 0, 32;
    %div/s;
    %store/vec4 v000001f78eb46e50_0, 0, 32;
    %load/vec4 v000001f78eb47670_0;
    %addi 1, 0, 32;
    %store/vec4 v000001f78eb47670_0, 0, 32;
    %jmp T_1.3;
T_1.4 ;
    %load/vec4 v000001f78eb46db0_0;
    %pushi/vec4 0, 0, 32;
    %cmp/ne;
    %flag_get/vec4 4;
    %store/vec4 v000001f78eb477b0_0, 0, 1;
    %delay 1000, 0;
    %load/vec4 v000001f78eb4f8c0_0;
    %addi 1, 0, 32;
    %store/vec4 v000001f78eb4f8c0_0, 0, 32;
    %load/vec4 v000001f78eb46d10_0;
    %load/vec4 v000001f78eb47670_0;
    %parti/s 3, 0, 2;
    %cmp/ne;
    %jmp/1 T_1.7, 6;
    %flag_mov 8, 6;
    %load/vec4 v000001f78eb46f90_0;
    %load/vec4 v000001f78eb477b0_0;
    %cmp/ne;
    %flag_or 6, 8;
T_1.7;
    %jmp/0xz  T_1.5, 6;
    %vpi_call/w 3 24 "$display", "RTL_AGENT_FAIL in=%h index=%h valid=%b expected_index=%d expected_valid=%b", v000001f78eb47b70_0, v000001f78eb46d10_0, v000001f78eb46f90_0, v000001f78eb47670_0, v000001f78eb477b0_0 {0 0 0};
    %vpi_call/w 3 26 "$finish" {0 0 0};
T_1.5 ;
T_1.2 ; for-loop step statement
    %load/vec4 v000001f78eb46db0_0;
    %addi 1, 0, 32;
    %store/vec4 v000001f78eb46db0_0, 0, 32;
    %jmp T_1.0;
T_1.1 ; for-loop exit label
    %vpi_call/w 3 29 "$display", "CHECKS=%0d exhaustive all 8-bit inputs", v000001f78eb4f8c0_0 {0 0 0};
    %vpi_call/w 3 30 "$display", "RTL_AGENT_PASS" {0 0 0};
    %vpi_call/w 3 31 "$finish" {0 0 0};
    %end;
    .thread T_1;
    .scope S_000001f78eb39ac0;
T_2 ;
    %delay 900000000, 0;
    %vpi_call/w 3 33 "$display", "RTL_AGENT_FAIL watchdog" {0 0 0};
    %vpi_call/w 3 33 "$finish" {0 0 0};
    %end;
    .thread T_2;
    .scope S_000001f78eb4a5e0;
T_3 ;
    %delay 1000000000, 0;
    %vpi_call/w 5 5 "$display", "RTL_AGENT_FAIL: simulation exceeded 1000000 ns" {0 0 0};
    %vpi_call/w 5 6 "$finish" {0 0 0};
    %end;
    .thread T_3;
    .scope S_000001f78eb4a770;
T_4 ;
    %vpi_call/w 6 1 "$dumpfile", "wave.vcd" {0 0 0};
    %vpi_call/w 6 1 "$dumpvars", 32'sb00000000000000000000000000000000, S_000001f78eb39ac0 {0 0 0};
    %end;
    .thread T_4;

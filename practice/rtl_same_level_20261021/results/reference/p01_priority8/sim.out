#! /mingw64/bin/vvp
:ivl_version "13.0 (stable)" "(v13_0)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "D:\fgpa\readable-rtl-agent\.tools\iverilog\lib\ivl\system.vpi";
:vpi_module "D:\fgpa\readable-rtl-agent\.tools\iverilog\lib\ivl\vhdl_sys.vpi";
:vpi_module "D:\fgpa\readable-rtl-agent\.tools\iverilog\lib\ivl\vhdl_textio.vpi";

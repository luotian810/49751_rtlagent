# Reference only: no automatic .env loading. Never commit a real key.
# Agent and unchanged official baseline must use this same local Qwen model.
# The agent rejects other models and non-loopback endpoints before any request.
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=Qwen3-14B-Q4_K_M
MODEL_NAME=Qwen3-14B-Q4_K_M
LLM_API_KEY=dummy

# Optional explicit Python executable for run.ps1.
# PYTHON_EXE=C:\path\to\python.exe
